# KeeperHub organization API key. Created in the KeeperHub dashboard; starts with kh_.
KEEPERHUB_API_KEY=kh_your_key_here

# Override for self-hosted KeeperHub.
KEEPERHUB_BASE_URL=https://app.keeperhub.com

# Chain the keeper operates on. 11155111 = Ethereum Sepolia, 1 = mainnet.
POLARIS_CHAIN_ID=11155111

# Polaris deployment addresses for that chain (see packages/protocol/deployments.json).
POLARIS_LOAN_ENGINE=0x0000000000000000000000000000000000000000
POLARIS_MERCHANT_ESCROW=

# Where the keeper reads the loan book. Swap FileLoanBook for the Supabase-backed
# implementation in production.
POLARIS_LOAN_BOOK=keeper/data/loanbook.json

# Print intended actions without sending anything.
KEEPER_DRY_RUN=true

# Seconds between passes when running `pnpm keeper:all`.
KEEPER_INTERVAL_SECONDS=300

# The demo storefront's own merchant API key. Held server-side by
# /api/store/checkout so it is never shipped to the browser.
POLARIS_STORE_API_KEY=pk_live_...

# PolarisPayments, for subscription charges. Without it the subscriptions job
# reports that it has nothing to charge rather than failing.
POLARIS_PAYMENTS=0x...
