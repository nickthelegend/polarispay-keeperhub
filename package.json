{
  "name": "polarispay-keeperhub",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "PolarisPay: undercollateralized BNPL and crypto payments, with KeeperHub as the execution and reliability layer for collection, liquidation, dunning and settlement.",
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build",
    "typecheck": "pnpm -r --filter \"./packages/**\" --filter \"./keeper\" typecheck",
    "test": "pnpm --filter @polarispay/keeperhub test && pnpm --filter @polarispay/contracts test",
    "contracts:compile": "pnpm --filter @polarispay/contracts compile",
    "contracts:test": "pnpm --filter @polarispay/contracts test",
    "contracts:deploy": "pnpm --filter @polarispay/contracts deploy:sepolia",
    "db:migrate": "pnpm --filter @polarispay/db migrate",
    "keeper:collect": "pnpm --filter @polarispay/keeper collect",
    "keeper:liquidate": "pnpm --filter @polarispay/keeper liquidate",
    "keeper:settle": "pnpm --filter @polarispay/keeper settle",
    "keeper:all": "pnpm --filter @polarispay/keeper start",
    "workflows:push": "pnpm --filter @polarispay/keeper workflows:push"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
