{
  "name": "@polarispay/keeperhub",
  "version": "0.1.0",
  "description": "Typed KeeperHub execution client for PolarisPay: simulate-before-broadcast, idempotent charges, terminal status reconciliation and an auditable receipt for every credit action.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --experimental-strip-types test/*.test.ts"
  },
  "keywords": [
    "keeperhub",
    "bnpl",
    "polaris",
    "onchain-execution",
    "keeper"
  ],
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  }
}
