{
  "name": "@polarispay/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MongoDB data layer for PolarisPay: merchants, loans, installments, receipts and the event log.",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "node --experimental-strip-types src/migrate.ts",
    "seed": "node --experimental-strip-types src/seed.ts"
  },
  "dependencies": {
    "mongodb": "^6.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  }
}
