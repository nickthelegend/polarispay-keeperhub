{
  "name": "@polarispay/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MongoDB data layer for PolarisPay: merchants, loans, installments, receipts and the event log.",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "npm run build && node dist/migrate.js",
    "seed": "npm run build && node dist/seed.js",
    "sync": "npm run build && node dist/sync-chain.js",
    "purge": "npm run build && node dist/purge-unbacked.js",
    "test": "npm run build && node --test --experimental-strip-types test/*.test.ts",
    "reconcile": "npm run build && node dist/reconcile-cli.js",
    "index": "npm run build && node dist/index-cli.js",
    "demo:arm": "npm run build && node dist/demo-arm.js"
  },
  "dependencies": {
    "mongodb": "^6.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ]
}
